# Set default behavior to automatically handle line endings based on file type
* text=auto

# Web / Frontend source files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Backend / Java source files
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.gradle text eol=lf

# Shell scripts & wrappers
*.sh text eol=lf
mvnw text eol=lf
gradlew text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.jar binary
*.war binary
