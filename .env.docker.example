# ==============================================================================
# CoinTrack - Docker Compose Environment Configuration Template (.env.docker.example)
# Copy this file to '.env' before running 'docker compose up'
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Container)
# ------------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=cointrack_admin
MONGO_INITDB_ROOT_PASSWORD=cointrack_secure_password_123
MONGO_DATABASE=Finance

# Database Connection String used by Backend (Points to 'mongodb' docker service)
MONGODB_URI=mongodb://cointrack_admin:cointrack_secure_password_123@mongodb:27017/Finance?authSource=admin
MONGODB_DB=Finance

# ------------------------------------------------------------------------------
# 2. BACKEND SECURITY & ENCRYPTION SECRETS (Spring Boot)
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# JWT Signing Secret Key (Must be strong 256-bit key in production)
JWT_SECRET=<your-256-bit-jwt-secret>

# AES-256 Secret Key for User Sensitive Data Encryption (EXACTLY 32 characters)
ENCRYPTION_SECRET_KEY=<exactly-32-characters-key>

# TOTP Secret Key Encryption (64 Hexadecimal Characters)
TOTP_ENCRYPTION_KEY=<64-character-hex-key>

# Magic Link Secret for Passwordless Authentication (Minimum 32 characters)
EMAIL_MAGIC_LINK_SECRET=<32-character-magic-link-secret>

# ------------------------------------------------------------------------------
# 3. DOMAIN & CORS NETWORKING
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
EMAIL_API_BASE_URL=http://localhost:8080
EMAIL_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 4. EXTERNAL SERVICES & INTEGRATIONS
# ------------------------------------------------------------------------------
BREVO_API_KEY=<your-brevo-api-key>
BREVO_SENDER_EMAIL=cointrack.urva@gmail.com
BREVO_SENDER_NAME=CoinTrack Support
EMAIL_SUPPORT=cointrack.urva@gmail.com

GOLDAPI_KEY=<your-goldapi-key>
GOLD_API_KEY=<your-goldapi-key>

GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:3000/login

# ------------------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://backend:8080
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<your-google-client-id>
IFSC_API_KEY=<your-ifsc-api-key>
NEXT_PUBLIC_APP_NAME=CoinTrack
NEXT_PUBLIC_APP_VERSION=3.0.0
NEXT_PUBLIC_ENABLE_WEBSOCKETS=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_DEBUG=false
