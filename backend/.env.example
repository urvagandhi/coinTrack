# ═══════════════════════════════════════════════════════════════
# CoinTrack — Example Environment Variables (TEMPLATE ONLY)
# Copy to .env and fill in real values. NEVER commit real secrets.
# Loaded locally by spring-dotenv. In production, set these in the
# Render dashboard (see render.yaml).
# ═══════════════════════════════════════════════════════════════

# ── Environment ──────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Finance
MONGODB_DB=Finance

# ── JWT ──────────────────────────────────────────────────────
# Min 256 bits — generate: openssl rand -hex 32
JWT_SECRET=<your-256-bit-hex-secret>

# ── Encryption (AES-256-GCM) ────────────────────────────────
# Exactly 32 characters
ENCRYPTION_SECRET_KEY=<exactly-32-characters>

# ── TOTP (2FA) ───────────────────────────────────────────────
# 64 hex chars — generate: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=<64-character-hex-key>

# ── Email (Brevo) ────────────────────────────────────────────
BREVO_API_KEY=<your-brevo-api-key>
EMAIL_MAGIC_LINK_SECRET=<strong-random-secret-32+chars>
EMAIL_BASE_URL=http://localhost:3000
EMAIL_API_BASE_URL=http://localhost:8080

# ── Frontend / CORS ──────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Server ───────────────────────────────────────────────────
PORT=8080

# ── GoldAPI.io (live metal rates) ────────────────────────────
GOLDAPI_KEY=<your-goldapi-key>

# ── Google SSO (optional) ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/login
